# Copie para .env.local e preencha. Nunca commite o .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: usado pelo seed e pelo /dev/entrar. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Domínios de e-mail aceitos no login, separados por vírgula.
ALLOWED_EMAIL_DOMAINS=fiap.com.br

# URL pública do app (usada no link mágico).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só para publicar a demonstração (dados fictícios, login com qualquer usuário) sem Supabase.
# Em desenvolvimento a demonstração liga sozinha quando o Supabase não está configurado.
# NEXT_PUBLIC_MODO_DEMO=1
