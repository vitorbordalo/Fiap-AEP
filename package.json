{
  "name": "achados-e-perdidos-fiap",
  "version": "0.1.0",
  "private": true,
  "description": "Achados e Perdidos FIAP: cadastro, busca e retirada de itens esquecidos no campus.",
  "scripts": {
    "dev": "next dev",
    "demo": "node scripts/demo.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validar": "node scripts/db/validar-migrations.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed/index.mjs",
    "db:placeholders": "node scripts/seed/gerar-placeholders.mjs",
    "test:integracao": "vitest run --config vitest.integracao.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "node scripts/e2e-supabase.mjs",
    "db:cadastros": "node --env-file=.env.local scripts/cadastros/index.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/functions": "^3.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
